# Copia este archivo a .env.local (COPIAR, no renombrar) y completa los valores.
# .env.local NO se sube a GitHub.

# Supabase → Project Settings → API
# Solo la URL base, sin /rest/v1/
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública (anon / publishable). Solo puede leer el catálogo público.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave de servicio: acceso total. SOLO en el servidor, nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp de la tienda, con indicativo y solo dígitos (ej. 573001234567).
# Habilita el botón "Confirmar por WhatsApp" en la página del pedido.
NEXT_PUBLIC_WHATSAPP_NUMERO=

# Dropi: token de integración que se genera al crear una tienda en "Mis tiendas".
# Solo servidor. Nunca con prefijo NEXT_PUBLIC_.
DROPI_TOKEN=

# Venndelo: refresh token de la API (lo entrega su soporte / menú Integraciones).
# ROTA con el tiempo: los scripts guardan el nuevo valor aquí automáticamente.
VENNDELO_REFRESH_TOKEN=
