# Copia este archivo a .env.local y completa los valores. .env.local NO se sube a GitHub.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública (anon / publishable). Solo puede leer el catálogo público.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave de servicio: acceso total. SOLO en el servidor, nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
